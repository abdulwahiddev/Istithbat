{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "esnext"
    ],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "../*"
      ],
      "next/link": [
        "src/shims/next-link.tsx"
      ],
      "next/navigation": [
        "src/shims/next-navigation.ts"
      ],
      "server-only": [
        "src/shims/server-only.ts"
      ],
      "react": [
        "node_modules/@types/react"
      ],
      "zod": [
        "node_modules/zod"
      ],
      "react/*": [
        "node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts"
  ]
}